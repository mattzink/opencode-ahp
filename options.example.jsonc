{
  // Documented option set for opencode-ahp.
  //
  // How to use: copy this file to `options.jsonc` next to src/index.ts when
  // running from a checkout, or — the usual case — put the values you want
  // in the plugin entry's `options` object in opencode.jsonc (that takes
  // precedence per key). npm installs ship no sibling options file.

  // Master switch; false → no listener, the plugin is fully inert.
  // "enabled": true,

  // WS listen port.
  // "port": 8765,

  // Bind address. Binding a non-loopback address REQUIRES a token (R4:
  // the listener refuses to start without one).
  // "host": "127.0.0.1",

  // WS path — VS Code's remoteAgentHosts URL carries it verbatim.
  // "path": "/ahp",

  // Auth token. Omit to auto-generate one on first start (persisted in
  // opencode's plugin storage, printed once to the service log). Accepted
  // via the `?token=` query param and `Authorization: Bearer <token>`.
  // "token": "…",

  // Origin allowlist: "*" (default) or an exact list, e.g.
  // ["vscode://vscode"]. The token is always required regardless.
  // "allowedOrigins": "*",

  // Native TLS termination via Bun.serve → wss:// (off-LAN transports,
  // D3). Paths to the PEM key and certificate files; with this set the
  // port is TLS-only (health endpoint → `curl -k https://…/healthz`).
  // The cert must be trusted by client machines for the URL hostname.
  // "tls": { "keyPath": "/path/key.pem", "certPath": "/path/cert.pem" },

  // Plain-HTTP health endpoint (no auth).
  // "healthPath": "/healthz",

  // Global actions kept for reconnect replay; older gaps → fresh snapshot.
  // "replayWindow": 1000,

  // Timestamped capture of the raw opencode event stream to the server
  // log — one line per raw V2 event: `event ok` (mapped to the host),
  // `event dropped (missing: <fields>)` (known type, unusable instance —
  // or a malformed envelope), `event unimplemented` (no handler for the
  // type) — with the raw `data` JSON (truncated to 300 chars). Off by
  // default: a busy turn emits dozens of lines. The LAN test server
  // script (scripts/ahp-server.mjs) enables it. Use it to attribute turn
  // latency to host vs client vs model (design.md §8.1).
  // "logEvents": true,

  // Host-side capability switches — never advertise what we don't
  // implement (in AHP 1.0.0 none of these is a wire field; discovery is
  // the state's optionality).
  // Default: { "changesets": true, "terminals": true, "automations": false }.
  // "changesets": false disables the diff channels (no changeset
  // catalogues in the session/chat snapshots; changeset URIs resolve to
  // nothing). Changesets require the location directory to be a git
  // repository.
  // "terminals": false disables both terminal kinds: the synthetic
  // shell-command terminal channels (shell-tool calls open no
  // ahp-terminal: channels and the root state carries no terminals list)
  // and the interactive pty shells (createTerminal/disposeTerminal
  // answer not-found).
  // "capabilities": { "changesets": false, "terminals": false, "automations": false }
}
